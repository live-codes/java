+    /**
+     * Fork addition: TeaVM 0.14.1 does not implement {@code Matcher.results()}, so its javac SDK
+     * does not declare it either and any program using it fails to compile. The JDK's version is
+     * lazy and continues from the matcher's current position, which is what this does too; the
+     * difference is that this collects eagerly, so it answers differently only for an unbounded
+     * input.
+     */
+    public org.teavm.classlib.java.util.stream.TStream<TMatchResult> results() {
+        org.teavm.classlib.java.util.TArrayList<TMatchResult> found =
+                new org.teavm.classlib.java.util.TArrayList<>();
+        while (find()) {
+            found.add(toMatchResult());
+        }
+        return found.stream();
+    }
