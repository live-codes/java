+                result.add(substring(start, i));
+                if (c == '\r' && i + 1 < chars.length && chars[i + 1] == '\n') {
+                    i++;
+                }
+                start = i + 1;
+            }
+        }
+        if (start < chars.length) {
+            result.add(substring(start, chars.length));
+        }
