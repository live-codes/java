+    /**
+     * Fork addition: a return or a throw, and nothing else. Used to drop statements the decompiler left
+     * after an unconditional exit -- emitting one of those leaves a value on the wasm stack, which the
+     * validator rejects. Deliberately not recursive: a statement that merely *contains* an exit still has
+     * to be followed by whatever the generator expects.
+     */
+    private static boolean isUnconditionalExit(Statement statement) {
+        return statement instanceof ReturnStatement || statement instanceof ThrowStatement;
+    }
