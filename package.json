{
  "name": "@live-codes/java-wasm",
  "version": "0.1.0",
  "description": "Client-side Java for LiveCodes: compile and run Java in the browser with javac + TeaVM compiled to WebAssembly.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-codes/java.git"
  },
  "homepage": "https://github.com/live-codes/java#readme",
  "bugs": {
    "url": "https://github.com/live-codes/java/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/java-wasm.iife.js",
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "types": "dist/java-wasm.iife.d.ts",
  "sideEffects": [
    "dist/java-wasm.iife.js"
  ],
  "keywords": [
    "java",
    "javac",
    "webassembly",
    "wasm",
    "teavm",
    "playground",
    "livecodes"
  ],
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "vendor:teavm": "node scripts/fetch-teavm.mjs",
    "prebuild": "node scripts/fetch-teavm.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test",
    "upgrade": "node scripts/upgrade.mjs",
    "upgrade:diff": "node scripts/upgrade.mjs --diff"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
